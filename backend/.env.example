ENVIRONMENT=development
DATABASE_URL=sqlite:///./sirius_gate.db
ORGANIZER_CODE=ORBIT-ADMIN
SECURITY_SECRET=replace-with-a-long-random-secret
CODE_HMAC_SECRET=replace-with-an-independent-long-random-secret
ACCESS_TOKEN_TTL_MINUTES=720
CORS_ORIGINS=http://localhost:4173,http://127.0.0.1:4173,http://localhost:4174,http://127.0.0.1:4174

# Настройки production-контейнера. В локальном запуске не используются.
API_WORKERS=2
DATABASE_STARTUP_MAX_ATTEMPTS=30
FORWARDED_ALLOW_IPS=*

# ИИ-ассистент (Alice AI через Yandex AI Studio). Ключ хранится только здесь,
# на сервере: не в Git, не в VITE_*, не в логах.
AI_ENABLED=false
YANDEX_AI_API_KEY=
YANDEX_AI_FOLDER_ID=
YANDEX_AI_MODEL_URI=
YANDEX_AI_BASE_URL=https://ai.api.cloud.yandex.net/v1
YANDEX_AI_TIMEOUT_SECONDS=20
YANDEX_AI_MAX_PARALLEL_REQUESTS=8
# Пример реальных значений:
# AI_ENABLED=true
# YANDEX_AI_FOLDER_ID=b1g53ftliu6csu3v94hv
# YANDEX_AI_API_KEY=<секретный ключ>
# YANDEX_AI_MODEL_URI=gpt://b1g53ftliu6csu3v94hv/aliceai-llm
# Для отладочных прогонов: gpt://<folder_id>/aliceai-llm-flash
