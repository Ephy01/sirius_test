ENVIRONMENT=development
DATABASE_URL=sqlite:///./sirius_gate.db
ORGANIZER_CODE=ORBIT-ADMIN
SECURITY_SECRET=replace-with-a-long-random-secret
CODE_HMAC_SECRET=replace-with-an-independent-long-random-secret
ACCESS_TOKEN_TTL_MINUTES=720
CORS_ORIGINS=http://localhost:4173,http://127.0.0.1:4173,http://localhost:4174,http://127.0.0.1:4174

API_WORKERS=2
DATABASE_STARTUP_MAX_ATTEMPTS=30
FORWARDED_ALLOW_IPS=*

AI_ENABLED=false
YANDEX_AI_API_KEY=
YANDEX_AI_FOLDER_ID=
YANDEX_AI_MODEL_URI=gpt://replace-with-your-folder-id/aliceai-llm-flash
YANDEX_AI_BASE_URL=https://ai.api.cloud.yandex.net/v1
YANDEX_AI_TIMEOUT_SECONDS=20
YANDEX_AI_MAX_PARALLEL_REQUESTS=8
