# Адрес сайта. Для первого запуска только по IP можно временно указать :80.
# После настройки DNS укажите домен без пути, например gate.example.ru.
SITE_ADDRESS=:80

# PostgreSQL. Используйте длинный случайный пароль из латинских букв и цифр.
POSTGRES_DB=sirius_gate
POSTGRES_USER=sirius_gate
POSTGRES_PASSWORD=replace-with-a-random-database-password

# Доступ и подпись сессий. Все три значения должны быть уникальными.
ORGANIZER_CODE=replace-with-a-private-organizer-code
SECURITY_SECRET=replace-with-at-least-64-random-hex-characters
CODE_HMAC_SECRET=replace-with-another-64-random-hex-characters
ACCESS_TOKEN_TTL_MINUTES=720
API_WORKERS=2
DATABASE_STARTUP_MAX_ATTEMPTS=30
FORWARDED_ALLOW_IPS=*

# При same-origin размещении CORS не требуется. Если понадобится отдельный
# frontend-домен, перечислите разрешённые origin через запятую.
CORS_ORIGINS=

# Alice AI / Yandex AI Studio. Ключ никогда не должен попадать в Git.
AI_ENABLED=false
YANDEX_AI_API_KEY=
YANDEX_AI_FOLDER_ID=
YANDEX_AI_MODEL_URI=
YANDEX_AI_BASE_URL=https://ai.api.cloud.yandex.net/v1
YANDEX_AI_TIMEOUT_SECONDS=20
YANDEX_AI_MAX_PARALLEL_REQUESTS=8
